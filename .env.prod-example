# ==============================================================================
# BarberBot AI - Exemplo de Configuração de Ambiente para Produção / Nuvem (.env)
# ==============================================================================
# Renomeie este arquivo para .env no seu servidor EC2 e preencha os dados abaixo.
# ==============================================================================

# 1. Configuração do Banco de Dados PostgreSQL (Docker interno)
# Estes dados devem bater com os do docker-compose.yml no EC2
POSTGRES_DB=barberbot_db
POSTGRES_USER=barberbot_user
POSTGRES_PASSWORD=barberbot_pass

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/barberbot_db
SPRING_DATASOURCE_USERNAME=barberbot_user
SPRING_DATASOURCE_PASSWORD=barberbot_pass

# 2. Configurações do Administrador do Sistema (WhatsApp)
# Coloque o número do seu professor ou o número administrativo desejado.
# IMPORTANTE: Deve conter o código do país (55 para Brasil), o DDD e o número, tudo junto sem espaços, traços ou o sinal +.
# Exemplo: ADMIN_PHONE=5511999999999
ADMIN_PHONE=5534992593025

# 3. Credenciais de Inteligência Artificial e Segurança
# Insira sua chave privada de API da OpenAI (sk-...)
OPENAI_API_KEY=sua_chave_openai_aqui

# Chave de acesso interna da Evolution API (mantenha barberbot ou altere se desejar mais segurança)
EVOLUTION_API_KEY=barberbot
