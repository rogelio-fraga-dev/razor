# ==============================================================================
# Razor — modelo de .env para PRODUÇÃO
# ==============================================================================
# Copie para .env no servidor e substitua TODOS os valores marcados como TROCAR.
#
# Os placeholders foram escolhidos para NÃO funcionarem se copiados sem edição: a
# aplicação recusa subir (ou desabilita o recurso, fail-closed) enquanto eles estiverem
# aqui. Um arquivo de exemplo com senha plausível é pior do que nenhum — ele funciona,
# ninguém percebe, e a senha de exemplo vai para produção.
#
# Como gerar os segredos (Linux/macOS):
#   openssl rand -base64 48
# No Windows (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# ==============================================================================

# --- 1. Banco de dados --------------------------------------------------------
POSTGRES_DB=razor
POSTGRES_USER=TROCAR_usuario_do_banco
POSTGRES_PASSWORD=TROCAR_senha_forte_gerada_aleatoriamente

SPRING_DATASOURCE_URL=jdbc:postgresql://TROCAR_host_do_banco:5432/razor
SPRING_DATASOURCE_USERNAME=TROCAR_usuario_do_banco
SPRING_DATASOURCE_PASSWORD=TROCAR_senha_forte_gerada_aleatoriamente

# --- 2. Segredos da aplicação -------------------------------------------------
# Assina os JWT do painel. Menos de 32 caracteres = chave aleatória a cada boot, e todo
# mundo cai do painel a cada restart. Gere um valor longo e único por ambiente.
RAZOR_JWT_SECRET=TROCAR_gere_um_segredo_de_no_minimo_48_caracteres

# Exigido no webhook da Evolution. VAZIO DESABILITA O WEBHOOK (fail-closed) — sem ele
# qualquer um poderia forjar uma mensagem com o telefone de um admin e dar comandos.
WEBHOOK_TOKEN=TROCAR_gere_um_token_aleatorio

# Exigido para provisionar uma barbearia nova. Vazio desabilita o onboarding (fail-closed).
ONBOARDING_API_KEY=TROCAR_gere_uma_chave_aleatoria

# --- 3. IA --------------------------------------------------------------------
# Chave da OpenAI (platform.openai.com). O custo é da plataforma, não do tenant.
OPENAI_API_KEY=TROCAR_sk_sua_chave_da_openai

# --- 4. WhatsApp (Evolution API) ----------------------------------------------
# Chave de acesso da Evolution. NÃO deixe o valor de desenvolvimento ("barberbot"):
# a Evolution expõe uma API de administração, e essa chave é o que a protege.
EVOLUTION_API_KEY=TROCAR_chave_forte_da_evolution
EVOLUTION_BASE_URL=http://evolution-api:8080

# --- 5. Contatos e domínios ---------------------------------------------------
# Telefone(s) pessoal(is) do dono, com 55 + DDD, separados por vírgula. É por onde ele
# comanda o bot e recebe alertas — NÃO pode ser o mesmo número conectado como bot.
ADMIN_PHONES=TROCAR_5511999999999

# Origens permitidas no CORS do painel. Liste os domínios reais, nunca "*".
RAZOR_CORS_ORIGINS=https://TROCAR-app.seudominio.com.br

# A sessao do painel e um cookie HttpOnly. Secure=true faz o navegador so envia-lo por HTTPS —
# mantenha true em producao (o docker-compose local usa false por padrao).
RAZOR_COOKIE_SECURE=true

# IP real do cliente (freios de login e de API): o backend so confia no X-Forwarded-For vindo
# de proxy em rede privada/loopback (o nginx do painel no compose). Se houver um load balancer
# com IP PUBLICO na frente, informe a regex dele aqui — senao todo mundo vira o IP do LB.
# SERVER_TOMCAT_REMOTEIP_INTERNALPROXIES=10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}

# --- 6. Trava de segredos ----------------------------------------------------
# Com true o backend RECUSA subir se algum segredo acima estiver vazio, curto ou ainda com
# cara de exemplo (TROCAR_, dev-, barberbot...). O docker-compose.prod.yml já liga isso; deixe
# aqui também se rodar o backend fora do compose. Os valores nunca aparecem no log de erro.
RAZOR_STRICT_SECRETS=true

# --- 7. Freio de requisições (opcional) ---------------------------------------
# Padrões já vêm aplicados; descomente só para ajustar.
# RAZOR_RATE_LIMIT_ADMIN=240
# RAZOR_RATE_LIMIT_WEBHOOK=120
