# Copie este arquivo para .env.local (gitignored) e preencha os valores reais.
# O dev.ps1 le este arquivo e sobe o backend com essas variaveis.

# Banco local do Razor (container razor-postgres na porta 5433)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/barberbot_db

# Telefone(s) admin do tenant padrao (fallback)
ADMIN_PHONES=5511999999999

# >>> OBRIGATORIO para a IA responder: sua chave real da OpenAI (platform.openai.com) <<<
OPENAI_API_KEY=sk-SUA-CHAVE-REAL-AQUI

# Chave que protege o onboarding self-service local
ONBOARDING_API_KEY=dev-onboarding-key

# Segredo dos JWT do painel (qualquer string longa em dev)
RAZOR_JWT_SECRET=dev-jwt-secret-local-please-change-0123456789

# API key da Evolution local (container razor-evolution)
EVOLUTION_API_KEY=barberbot

# Segredo do webhook da Evolution (fail-closed: sem ele o bot nao recebe mensagens).
# A Evolution deve apontar para http://host.docker.internal:8081/api/webhook?token=<este valor>
WEBHOOK_TOKEN=dev-webhook-token
