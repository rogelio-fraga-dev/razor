# Variaveis do stack Docker. Copie para .env (gitignored) e ajuste o que precisar:
#
#   cp .env.docker.example .env
#
# Tudo aqui tem default no docker-compose.yml — o stack sobe sem .env nenhum. Este arquivo
# existe para quando voce quiser a IA respondendo, o seu telefone como admin, ou trocar portas.

# --- IA -----------------------------------------------------------------------------------
# Chave real da OpenAI (platform.openai.com). Sem ela o bot nao gera resposta e o painel
# mostra a IA como nao configurada — o resto do sistema funciona normalmente.
OPENAI_API_KEY=sk-dummy-local

# --- Acesso -------------------------------------------------------------------------------
# Telefone(s) com poder de admin no bot, com 55 e DDD. Separe por virgula.
ADMIN_PHONES=5511999999999

# Segredo dos JWT do painel. Menos de 32 caracteres = chave aleatoria a cada boot (voce cai
# do painel a cada restart do backend).
RAZOR_JWT_SECRET=dev-jwt-secret-local-troque-em-producao-0123456789

# Chave do endpoint de provisionamento de barbearia. Vazio desabilita o onboarding.
ONBOARDING_API_KEY=dev-onboarding-key

# Segredo que a Evolution precisa enviar no webhook. Vazio desabilita o webhook (fail-closed).
WEBHOOK_TOKEN=dev-webhook-token

# Console da plataforma (/plataforma). Vazio = desligado. Chave: openssl rand -base64 32
RAZOR_SECRETS_KEY=
RAZOR_PLATFORM_ADMIN_EMAIL=
RAZOR_PLATFORM_ADMIN_PASSWORD=

# --- Banco --------------------------------------------------------------------------------
POSTGRES_DB=barberbot_db
POSTGRES_USER=barberbot_user
POSTGRES_PASSWORD=barberbot_pass

# --- Landing ------------------------------------------------------------------------------
# Para onde o "Entrar" e os CTAs de plano da landing apontam. Tem que ser um endereco que o
# NAVEGADOR alcance (nao um nome de servico do compose). Em producao vira o dominio do painel.
RAZOR_PANEL_URL=http://localhost:3000

# --- Portas no host -----------------------------------------------------------------------
SITE_PORT=8000
WEB_PORT=3000
BACKEND_PORT=8081
POSTGRES_PORT=5433
EVOLUTION_PORT=8080

# --- WhatsApp (so com --profile bot) ------------------------------------------------------
EVOLUTION_API_KEY=barberbot
