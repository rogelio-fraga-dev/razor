# Base da API em producao (em dev o vite faz proxy de /api -> backend, veja vite.config.ts).
# Deixe vazio para usar o mesmo host (recomendado quando front e API sao servidos juntos).
VITE_API_URL=

# Alvo do proxy de dev (opcional; padrao http://localhost:8081)
VITE_API_PROXY=http://localhost:8081
