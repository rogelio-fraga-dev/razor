# Base da API. Deixe VAZIO: a sessao e um cookie HttpOnly SameSite=Strict e o token CSRF so e
# legivel na mesma origem, entao o painel precisa falar com a API pelo proprio host (proxy do
# vite em dev, nginx no Docker/producao).
VITE_API_URL=

# Alvo do proxy de dev (opcional; padrao http://localhost:8081)
VITE_API_PROXY=http://localhost:8081

# Endereco da landing institucional, para o link "voltar ao site" na tela de login.
# Vazio esconde o link — melhor do que um link quebrado quando o site nao esta no ar.
VITE_SITE_URL=http://localhost:8000
